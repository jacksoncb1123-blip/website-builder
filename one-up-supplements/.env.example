# ─────────────────────────────────────────────────────────────────────────────
#  One Up Supplements — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your real values:
#      cp .env.example .env
#
#  With NO values set, the storefront runs against Shopify's public demo
#  catalog (mock.shop) so you can preview the design immediately. Cart/checkout
#  need a real store.
#
#  WHERE TO GET THESE (Shopify Admin):
#  1. Create a store at https://www.shopify.com (a dev store is free:
#     https://shopify.dev/docs/api/development-stores).
#  2. Admin → Settings → Apps and sales channels → Develop apps →
#     "Create an app" → "Storefront API scopes" and enable:
#       unauthenticated_read_product_listings
#       unauthenticated_read_product_inventory
#       unauthenticated_read_checkouts
#       unauthenticated_write_checkouts
#       unauthenticated_read_content
#  3. "Install app", then copy the "Storefront API access token".
#  4. Your store domain is the *.myshopify.com one (NOT a custom domain).
#
#  FASTER: with the Hydrogen CLI you can skip the manual steps —
#      npx shopify hydrogen link
#      npx shopify hydrogen env pull
# ─────────────────────────────────────────────────────────────────────────────

# Any long random string. Signs the session cookie. CHANGE THIS.
SESSION_SECRET="change-me-to-a-long-random-string"

# Your store domain, e.g. one-up-supplements.myshopify.com
# Leave unset to preview against the mock.shop demo catalog.
PUBLIC_STORE_DOMAIN="one-up-supplements.myshopify.com"

# Public Storefront API token from the custom app you created above.
PUBLIC_STOREFRONT_API_TOKEN=""

# Optional. Found in the Hydrogen sales channel; improves analytics + caching.
PUBLIC_STOREFRONT_ID=""

# Optional. Defaults to your store domain if blank.
PUBLIC_CHECKOUT_DOMAIN=""

# ── Customer Account API (OPTIONAL) ──────────────────────────────────────────
# Only needed for login / order history (the /account routes). The storefront,
# catalog, and cart all work without these.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

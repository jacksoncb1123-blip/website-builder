{%- comment -%} LumaSpace — Bundle upsell (side-by-side 2-pack deal) {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap');
  .lms-bun{--bg:#0a0a0f;--card:#12121a;--text:#f8fafc;--muted:#a1a1b5;--purple:#7c3aed;--purple-lt:#a78bfa;
    --amber:#f59e0b;--amber-lt:#fcd34d;--green:#34d399;--line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.14);
    background:var(--bg); color:var(--text); font-family:"Inter",sans-serif;}
  .lms-bun__wrap{max-width:1100px; margin:0 auto; padding:72px 20px;}
  .lms-bun__card{background:linear-gradient(135deg,rgba(124,58,237,.18),rgba(245,158,11,.08));
    border:1px solid var(--line-2); border-radius:24px; padding:30px; display:grid; gap:28px; align-items:center;
    box-shadow:0 30px 80px -40px rgba(124,58,237,.7);}
  .lms-bun__media{position:relative; aspect-ratio:4/3; border-radius:18px; overflow:hidden; border:1px solid var(--line-2);
    background:radial-gradient(60% 60% at 35% 40%, rgba(124,58,237,.6), transparent),
      radial-gradient(60% 60% at 70% 60%, rgba(245,158,11,.4), transparent), linear-gradient(160deg,#1a1140,#0a0a1f);}
  .lms-bun__media img{width:100%; height:100%; object-fit:cover; display:block;}
  .lms-bun__badge{position:absolute; top:14px; left:14px; background:var(--amber); color:#1a1205; font-weight:700;
    font-size:12px; letter-spacing:.04em; padding:6px 12px; border-radius:999px;}
  .lms-bun__eyebrow{font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--amber-lt);}
  .lms-bun h2{font-family:"Space Grotesk"; font-weight:700; letter-spacing:-.02em; font-size:clamp(24px,5.5vw,36px); margin:10px 0 12px;}
  .lms-bun__copy p{color:var(--muted); margin:0 0 18px;}
  .lms-bun__price{display:flex; align-items:baseline; gap:12px; margin-bottom:6px;}
  .lms-bun__now{font-family:"Space Grotesk"; font-size:34px; font-weight:700; color:var(--amber-lt);}
  .lms-bun__was{color:var(--muted); text-decoration:line-through; font-size:18px;}
  .lms-bun__save{color:var(--green); font-weight:600; font-size:14px; margin-bottom:18px;}
  .lms-bun__perks{list-style:none; margin:0 0 22px; padding:0; display:grid; gap:8px;}
  .lms-bun__perks li{display:flex; gap:9px; align-items:center; color:var(--muted); font-size:14px;}
  .lms-bun__perks svg{width:16px; height:16px; stroke:var(--green); fill:none; stroke-width:2; flex:0 0 16px;}
  .lms-bun__cta{display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:15px 28px;
    border-radius:999px; font-weight:700; font-size:16px; color:#fff; text-decoration:none;
    background:linear-gradient(135deg,var(--purple),#6d28d9); box-shadow:0 12px 30px -10px rgba(124,58,237,.7);
    transition:transform .2s,filter .2s;}
  .lms-bun__cta:hover{transform:translateY(-2px); filter:brightness(1.06);}
  @media (min-width:820px){ .lms-bun__card{grid-template-columns:1fr 1fr; padding:40px;} }
  @media (prefers-reduced-motion:reduce){ .lms-bun__cta:hover{transform:none;} }
</style>
<section class="lms-bun">
  <div class="lms-bun__wrap">
    <div class="lms-bun__card">
      <div class="lms-bun__media">
        <span class="lms-bun__badge">{{ section.settings.badge }}</span>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | default: 'LumaSpace 2-pack' | escape }}" width="800" height="600" loading="lazy">
        {%- endif -%}
      </div>
      <div class="lms-bun__copy">
        <span class="lms-bun__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subtext }}</p>
        <div class="lms-bun__price">
          <span class="lms-bun__now">{{ section.settings.price_now }}</span>
          <span class="lms-bun__was">{{ section.settings.price_was }}</span>
        </div>
        <div class="lms-bun__save">{{ section.settings.save_text }}</div>
        <ul class="lms-bun__perks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><svg viewBox="0 0 24 24"><path d="M4 12l4 4 12-12"/></svg> {{ block.settings.perk }}</li>
          {%- endfor -%}
        </ul>
        <a class="lms-bun__cta" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LumaSpace Bundle",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Image badge", "default": "BEST VALUE" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most popular" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the 2-Pack & save more" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "One for your room, one for a gift. Buy 1 Get 1 50% off — the deal everyone grabs." },
    { "type": "image_picker", "id": "image", "label": "Bundle image" },
    { "type": "text", "id": "price_now", "label": "Bundle price", "default": "$59.99" },
    { "type": "text", "id": "price_was", "label": "Compare-at", "default": "$119.98" },
    { "type": "text", "id": "save_text", "label": "Save text", "default": "You save $59.99 (50% off the 2nd)" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add 2-Pack to Cart" },
    { "type": "url", "id": "button_url", "label": "Button link (product page)" }
  ],
  "blocks": [{
    "type": "perk",
    "name": "Perk",
    "settings": [{ "type": "text", "id": "perk", "label": "Perk", "default": "Free shipping on both" }]
  }],
  "max_blocks": 5,
  "presets": [{
    "name": "LumaSpace Bundle",
    "blocks": [
      { "type": "perk", "settings": { "perk": "2nd projector is 50% off" } },
      { "type": "perk", "settings": { "perk": "Free tracked shipping on both" } },
      { "type": "perk", "settings": { "perk": "Perfect gift — ships ready" } },
      { "type": "perk", "settings": { "perk": "30-day money-back on the bundle" } }
    ]
  }]
}
{% endschema %}

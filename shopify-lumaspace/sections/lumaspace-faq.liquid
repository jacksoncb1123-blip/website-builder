{%- comment -%} LumaSpace — FAQ (accordion, 6 Q&A) {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap');
  .lms-faq{--bg:#0a0a0f;--card:#12121a;--text:#f8fafc;--muted:#a1a1b5;--purple-lt:#a78bfa;--amber-lt:#fcd34d;
    --line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.14);
    background:var(--bg); color:var(--text); font-family:"Inter",sans-serif;}
  .lms-faq__wrap{max-width:780px; margin:0 auto; padding:72px 20px;}
  .lms-faq__head{text-align:center; margin-bottom:36px;}
  .lms-faq__eyebrow{font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--amber-lt);}
  .lms-faq h2{font-family:"Space Grotesk"; font-weight:700; letter-spacing:-.02em; font-size:clamp(26px,6vw,40px); margin:10px 0 0;}
  .lms-faq__item{border:1px solid var(--line); border-radius:14px; margin-bottom:12px; background:var(--card); overflow:hidden;}
  .lms-faq__item[open]{border-color:var(--line-2);}
  .lms-faq__q{list-style:none; cursor:pointer; padding:18px 20px; font-weight:600; font-size:16px;
    display:flex; justify-content:space-between; align-items:center; gap:16px;}
  .lms-faq__q::-webkit-details-marker{display:none;}
  .lms-faq__q:hover{background:rgba(255,255,255,.03);}
  .lms-faq__chev{flex:0 0 20px; transition:transform .25s ease; color:var(--purple-lt);}
  .lms-faq__chev svg{width:20px; height:20px; stroke:currentColor; fill:none; stroke-width:2;}
  .lms-faq__item[open] .lms-faq__chev{transform:rotate(180deg);}
  .lms-faq__a{padding:0 20px 18px; color:var(--muted); font-size:14.5px; line-height:1.65;}
  @media (prefers-reduced-motion:reduce){ .lms-faq__chev{transition:none;} }
</style>
<section class="lms-faq">
  <div class="lms-faq__wrap">
    <div class="lms-faq__head">
      <span class="lms-faq__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- for block in section.blocks -%}
      <details class="lms-faq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
        <summary class="lms-faq__q">
          {{ block.settings.question }}
          <span class="lms-faq__chev" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>
        </summary>
        <div class="lms-faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "LumaSpace FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need to know" }
  ],
  "blocks": [{
    "type": "qa",
    "name": "Q&A",
    "settings": [
      { "type": "text", "id": "question", "label": "Question", "default": "How does it power on?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>It's USB powered — plug it into any charger, laptop or power bank with the included cable.</p>" }
    ]
  }],
  "max_blocks": 8,
  "presets": [{
    "name": "LumaSpace FAQ",
    "blocks": [
      { "type": "qa", "settings": { "question": "How does it connect and power on?", "answer": "<p>It's USB powered — just plug it into any phone charger, laptop, or power bank with the included cable. Control it with the included remote or the free app (iOS &amp; Android).</p>" } },
      { "type": "qa", "settings": { "question": "How fast is shipping?", "answer": "<p>Free tracked shipping on every order. Most orders arrive in <strong>2–3 business days</strong>, and you'll get a tracking link by email the moment it ships.</p>" } },
      { "type": "qa", "settings": { "question": "Is it quiet enough to sleep with?", "answer": "<p>Yes. The motor runs under 25dB — quieter than a whisper. There's also a static (no-rotation) mode and a sleep timer.</p>" } },
      { "type": "qa", "settings": { "question": "What if I don't love it?", "answer": "<p>You're covered by our <strong>30-day money-back guarantee</strong>. If it's not your vibe, send it back for a full refund.</p>" } },
      { "type": "qa", "settings": { "question": "How big a room can it fill?", "answer": "<p>It comfortably covers rooms up to ~430 sq ft (40 m²) — bedrooms, dorms, living rooms and ceilings. Tilt the head to aim it.</p>" } },
      { "type": "qa", "settings": { "question": "Is the Buy 1 Get 1 50% off deal real?", "answer": "<p>Yep — add 2 to your cart and the second is automatically 50% off. Most people grab a second as a gift.</p>" } }
    ]
  }]
}
{% endschema %}

{%- comment -%} LumaSpace — How It Works (4 numbered steps) {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap');
  .lms-how{--bg:#0a0a0f;--card:#12121a;--text:#f8fafc;--muted:#a1a1b5;--purple:#7c3aed;--purple-lt:#a78bfa;
    --amber-lt:#fcd34d;--line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.14);
    background:linear-gradient(180deg,#0b0b14,#0a0a0f); color:var(--text); font-family:"Inter",sans-serif;}
  .lms-how__wrap{max-width:1180px; margin:0 auto; padding:72px 20px;}
  .lms-how__head{text-align:center; max-width:54ch; margin:0 auto 44px;}
  .lms-how__eyebrow{font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--amber-lt);}
  .lms-how h2{font-family:"Space Grotesk"; font-weight:700; letter-spacing:-.02em; font-size:clamp(26px,6vw,40px); margin:10px 0;}
  .lms-how__head p{color:var(--muted); margin:0;}
  .lms-how__grid{display:grid; gap:18px; grid-template-columns:1fr; counter-reset:step;}
  .lms-how__step{position:relative; background:var(--card); border:1px solid var(--line); border-radius:18px; padding:26px 24px;}
  .lms-how__num{font-family:"Space Grotesk"; font-weight:700; font-size:18px; width:42px; height:42px; border-radius:12px;
    display:grid; place-items:center; margin-bottom:14px;
    background:linear-gradient(135deg,rgba(124,58,237,.3),rgba(245,158,11,.18)); border:1px solid var(--line-2); color:var(--purple-lt);}
  .lms-how__step h3{font-family:"Space Grotesk"; font-size:17px; margin:0 0 6px;}
  .lms-how__step p{color:var(--muted); font-size:14px; margin:0;}
  @media (min-width:680px){ .lms-how__grid{grid-template-columns:1fr 1fr;} }
  @media (min-width:1020px){ .lms-how__grid{grid-template-columns:repeat(4,1fr);} }
</style>
<section class="lms-how">
  <div class="lms-how__wrap">
    <div class="lms-how__head">
      <span class="lms-how__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="lms-how__grid">
      {%- assign n = 0 -%}
      {%- for block in section.blocks -%}{%- assign n = n | plus: 1 -%}
        <div class="lms-how__step" {{ block.shopify_attributes }}>
          <div class="lms-how__num">{{ n }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LumaSpace How It Works",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Set up in 60 seconds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "No tools, no app required to start. Plug in and you're glowing." }
  ],
  "blocks": [{
    "type": "step",
    "name": "Step",
    "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Plug it in" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Connect the USB cable to any charger or power bank." }
    ]
  }],
  "max_blocks": 4,
  "presets": [{
    "name": "LumaSpace How It Works",
    "blocks": [
      { "type": "step", "settings": { "title": "Plug it in", "text": "Connect the USB cable to any charger or power bank." } },
      { "type": "step", "settings": { "title": "Pick your vibe", "text": "Tap the remote to choose galaxy, sunset, aurora or ocean." } },
      { "type": "step", "settings": { "title": "Aim & rotate", "text": "Tilt the head and turn on 360° motion to fill the room." } },
      { "type": "step", "settings": { "title": "Vibe out", "text": "Dim the lights, hit record, or drift off with the sleep timer." } }
    ]
  }]
}
{% endschema %}

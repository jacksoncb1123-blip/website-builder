{%- comment -%} LumaSpace — Features (6 cards grid) {%- endcomment -%}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap');
  .lms-feat{--bg:#0a0a0f;--card:#12121a;--card-2:#181825;--text:#f8fafc;--muted:#a1a1b5;
    --purple:#7c3aed;--purple-lt:#a78bfa;--amber:#f59e0b;--amber-lt:#fcd34d;
    --line:rgba(255,255,255,.08);--line-2:rgba(255,255,255,.14);
    background:var(--bg); color:var(--text); font-family:"Inter",sans-serif;}
  .lms-feat__wrap{max-width:1180px; margin:0 auto; padding:72px 20px;}
  .lms-feat__head{text-align:center; max-width:58ch; margin:0 auto 40px;}
  .lms-feat__eyebrow{font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--amber-lt);}
  .lms-feat h2{font-family:"Space Grotesk"; font-weight:700; letter-spacing:-.02em; font-size:clamp(26px,6vw,40px); margin:10px 0;}
  .lms-feat__head p{color:var(--muted); margin:0;}
  .lms-feat__grid{display:grid; gap:16px; grid-template-columns:1fr;}
  .lms-feat__card{background:var(--card); border:1px solid var(--line); border-radius:18px; padding:24px;
    transition:transform .25s ease, border-color .25s, background .25s;}
  .lms-feat__card:hover{transform:translateY(-4px); border-color:var(--line-2); background:var(--card-2);}
  .lms-feat__ic{width:46px; height:46px; border-radius:12px; display:grid; place-items:center; margin-bottom:14px;
    background:linear-gradient(135deg,rgba(124,58,237,.25),rgba(245,158,11,.15)); border:1px solid var(--line-2); color:var(--purple-lt);}
  .lms-feat__ic svg{width:24px; height:24px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round;}
  .lms-feat__card h3{font-family:"Space Grotesk"; font-size:17px; margin:0 0 6px;}
  .lms-feat__card p{color:var(--muted); font-size:14px; margin:0;}
  @media (min-width:620px){ .lms-feat__grid{grid-template-columns:1fr 1fr;} }
  @media (min-width:980px){ .lms-feat__grid{grid-template-columns:1fr 1fr 1fr;} }
  @media (prefers-reduced-motion:reduce){ .lms-feat__card:hover{transform:none;} }
</style>
<section class="lms-feat">
  <div class="lms-feat__wrap">
    <div class="lms-feat__head">
      <span class="lms-feat__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="lms-feat__grid">
      {%- for block in section.blocks -%}
        <div class="lms-feat__card" {{ block.shopify_attributes }}>
          <div class="lms-feat__ic">
            {%- case block.settings.icon -%}
              {%- when 'rotate' -%}<svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9"/><path d="M12 7v5l3 2"/><path d="M21 3v6h-6"/></svg>
              {%- when 'color' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/></svg>
              {%- when 'quiet' -%}<svg viewBox="0 0 24 24"><path d="M3 10v4h4l5 5V5L7 10H3z"/><path d="M16 9a3 3 0 0 1 0 6"/></svg>
              {%- when 'usb' -%}<svg viewBox="0 0 24 24"><path d="M9 7V4h6v3"/><rect x="7" y="7" width="10" height="13" rx="2"/><path d="M12 11v5"/></svg>
              {%- when 'remote' -%}<svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/><circle cx="5" cy="12" r="1.5"/></svg>
              {%- when 'music' -%}<svg viewBox="0 0 24 24"><path d="M9 18V5l10-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="16" cy="16" r="3"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- endcase -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "LumaSpace Features",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it sells out" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Premium features, dorm-friendly price" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Engineered to look incredible on camera and feel calming in person." }
  ],
  "blocks": [{
    "type": "feature",
    "name": "Feature",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "rotate",
        "options": [
          {"value":"rotate","label":"360° rotation"},
          {"value":"color","label":"Color modes"},
          {"value":"quiet","label":"Whisper-quiet"},
          {"value":"usb","label":"USB power"},
          {"value":"remote","label":"Remote / app"},
          {"value":"music","label":"Music sync"},
          {"value":"shield","label":"Durability"}
        ] },
      { "type": "text", "id": "title", "label": "Title", "default": "360° rotating galaxy" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "A motorized head sweeps stars across every wall and the ceiling." }
    ]
  }],
  "max_blocks": 6,
  "presets": [{
    "name": "LumaSpace Features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "rotate", "title": "360° rotating galaxy", "text": "A motorized head sweeps stars across every wall and the ceiling." } },
      { "type": "feature", "settings": { "icon": "color", "title": "14 color modes", "text": "Galaxy, sunset, aurora, ocean and more — set the exact vibe." } },
      { "type": "feature", "settings": { "icon": "quiet", "title": "Whisper-quiet motor", "text": "Under 25dB, so it never interrupts sleep or filming." } },
      { "type": "feature", "settings": { "icon": "usb", "title": "USB powered", "text": "Plug into any charger, laptop or power bank. No batteries." } },
      { "type": "feature", "settings": { "icon": "remote", "title": "Remote & app control", "text": "Adjust brightness, speed and color from bed. Sleep timer built in." } },
      { "type": "feature", "settings": { "icon": "music", "title": "Music-reactive sync", "text": "Built-in mic pulses the stars to your music. Instant party mode." } }
    ]
  }]
}
{% endschema %}
